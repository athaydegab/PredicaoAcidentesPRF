# ==========================================
# AMBIENTE VIRTUAL E DEPENDÊNCIAS
# ==========================================
venv/
env/
.env

# ==========================================
# DADOS (CRÍTICO)
# Ignora todos os arquivos dentro das pastas de dados, mas permite que a estrutura de pastas suba pro Git.
data/raw/*
data/processed/*
*.csv
*.xlsx
*.parquet

# Exceção: Mantém arquivos .gitkeep para preservar a estrutura de diretórios vazia
!data/raw/.gitkeep
!data/processed/.gitkeep

# JUPYTER NOTEBOOKS E PYTHON
.ipynb_checkpoints/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# CONFIGURAÇÕES DE IDE E SISTEMA OPERACIONAL
.vscode/
.idea/
.claude/
.DS_Store
Thumbs.db

*.pkl

graphify-out/
_graphify_src/
models/*
# Excecao: modelo real usado em producao pelo app.py (pequeno, precisa estar no repo
# para o Streamlit Cloud conseguir clonar e rodar o app)
!models/modelo_xgboost_calibrado.pkl
!models/colunas_treino.pkl
